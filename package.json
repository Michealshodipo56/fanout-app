{
  "name": "fanout-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build && pnpm --filter \"./services/*\" build",
    "dev": "pnpm --parallel dev",
    "test": "pnpm build && node --test packages/*/dist/*.test.js",
    "lint": "pnpm build"
  },
  "devDependencies": {
    "@neon/config": "^1.8.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "pg": "^8.13.0"
  }
}
